{
  "name": "smallest-power-of-two",
  "version": "2.0.0",
  "description": "Find the smallest power of 2 with magnitude greater than or equal to the input. Zero runtime dependencies, ESM, TypeScript types.",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist/index.js",
    "dist/index.js.map",
    "dist/index.d.ts",
    "dist/index.d.ts.map"
  ],
  "engines": {
    "bun": ">=1.3"
  },
  "scripts": {
    "build": "tsc",
    "test": "bun test",
    "lint": "tsc --noEmit",
    "prepublishOnly": "bun run build"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cinderblock/smallest-power-of-two.git"
  },
  "keywords": [
    "power",
    "two",
    "2",
    "memory",
    "buffer",
    "size",
    "bit",
    "round-up"
  ],
  "author": "Cameron Tacklind <cameron@tacklind.com>",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/cinderblock/smallest-power-of-two/issues"
  },
  "homepage": "https://github.com/cinderblock/smallest-power-of-two#readme",
  "devDependencies": {
    "@types/node": "^22.19.19",
    "typescript": "^6.0.3"
  }
}
